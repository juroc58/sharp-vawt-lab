date-released: "2026-10-10"
license: MIT
repository-code: "https://github.com/juroc58/sharp-vawt-lab"
keywords:
  - vertical axis wind turbine
  - VAWT
  - cycloturbine
  - blade element momentum
  - dynamic stall
  - passive variable pitch
  - centrifugal pendulum pitch control
  - renewable energy
